# Preferred: private store connected to Vercel with short-lived OIDC authentication.
BLOB_STORE_ID=
# Optional legacy/local alternative. Never expose credentials to the client.
BLOB_READ_WRITE_TOKEN=
# Required server-only random secret, at least 32 characters. Keep stable across deploys.
INQUIRY_RECEIPT_SECRET=
# Enable previews only with a separate private test store.
INQUIRY_PREVIEW_ENABLED=false

# Optional email notification after a lead has been captured successfully.
RESEND_API_KEY=
LEAD_NOTIFICATION_TO=andre.wang@compass.com
LEAD_NOTIFICATION_FROM="2628 Photinia <inquiries@your-verified-domain.com>"
LEAD_NOTIFICATION_SUBJECT="New inquiry for 2628 Photinia Court"

# Production-only Google Sheets mirror. Do not configure these in Preview or Development.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=
# Protects Vercel's internal daily reconciliation route.
CRON_SECRET=

# Canonical production origin.
NEXT_PUBLIC_SITE_URL=https://2628photinia.com/
